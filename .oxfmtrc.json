{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "svelte": {},
  "ignorePatterns": [
    "out",
    "dist",
    "nicegal-server",
    "src/shared/paraglide",
    "pnpm-lock.yaml",
    "LICENSE.md",
    "tsconfig.json",
    "tsconfig.*.json"
  ],
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  }
}
