{
  "name": "nicegal",
  "desktopName": "io.github.nicegal.nicegal",
  "license": "MIT",
  "version": "0.0.0",
  "description": "Desktop gallery with OCR, semantic text, and image similarity search",
  "homepage": "https://github.com/centuryofimage/nicegal",
  "repository": "https://github.com/centuryofimage/nicegal",
  "private": "true",
  "author": "nicegal",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "test": "node --test tests/*.test.mts tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mts tests/*.test.mjs",
    "format": "oxfmt --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run svelte-check",
    "build:backend": "bash nicegal-server/build-server.sh",
    "build:backend:win": "nicegal-server\\build-server.cmd",
    "start": "electron-vite preview",
    "start:dist:trace": "set \"RUST_LOG=nicegal_core=trace,nicegal_server=trace,tower_http=info,hyper=warn,h2=warn,tower=warn,rustls=warn\" && \"dist\\win-unpacked\\nicegal.exe\"",
    "licenses:frontend": "node scripts/collect-licenses.mjs",
    "dev": "pnpm run licenses:frontend --dev && electron-vite dev --remoteDebuggingPort 9222",
    "build": "pnpm run licenses:frontend && pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build:backend:win && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build:backend:win && pnpm run build && electron-builder --win --x64 --publish never",
    "build:mac": "pnpm run build:backend && pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build:backend && pnpm run build && electron-builder --linux",
    "prepare": "husky"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^7.0.0-alpha.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.4",
    "@viselect/vanilla": "^3.10.1",
    "electron": "^44.4.5",
    "electron-builder": "^27.0.0-alpha.8",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
